<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.seriouscompany.business.java.slopfizzbuzz</groupId>
  <artifactId>SlopFizzBuzzBrowser</artifactId>
  <version>1.0-SNAPSHOT</version>
  <properties>
    <browser.outputDirectory>${project.build.directory}/gate</browser.outputDirectory>
    <browser.mainClass>com.seriouscompany.browser.BrowserRuntime</browser.mainClass>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
      <version>3.2.13.RELEASE</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.seriouscompany.business.java.slopfizzbuzz</groupId>
      <artifactId>SlopFizzBuzzCore</artifactId>
      <version>1.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso-apis</artifactId>
      <version>0.16.0</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <version>0.16.0</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
      </plugin>
      <plugin>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-maven-plugin</artifactId>
        <version>0.16.0</version>
        <configuration>
          <mainClass>${browser.mainClass}</mainClass>
          <optimizationLevel>ADVANCED</optimizationLevel>
        </configuration>
        <executions>
          <execution>
            <id>wasm</id>
            <goals>
              <goal>compile</goal>
              <goal>copy-webassembly-gc-runtime</goal>
            </goals>
            <configuration>
              <targetType>WEBASSEMBLY_GC</targetType>
              <targetDirectory>${browser.outputDirectory}/wasm</targetDirectory>
              <targetFileName>enterprise.wasm</targetFileName>
            </configuration>
          </execution>
          <execution>
            <id>javascript</id>
            <goals>
              <goal>compile</goal>
            </goals>
            <configuration>
              <targetType>JAVASCRIPT</targetType>
              <targetDirectory>${browser.outputDirectory}/js</targetDirectory>
              <targetFileName>enterprise.js</targetFileName>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
