{
  "name": "slopbuzz-enterprise-showcase",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "marked": "^18.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "preview": "node scripts/serve.ts",
    "test:parity": "node scripts/browser-guard.ts node scripts/parity.ts",
    "test:e2e": "node scripts/browser-guard.ts node scripts/e2e.ts",
    "test:browser": "node scripts/browser-guard.ts pnpm exec playwright test",
    "test:browser-guard": "node --test scripts/browser-guard.test.ts",
    "test:compiler-gate": "node scripts/browser-guard.ts node scripts/compiler-gate.ts",
    "analytics:setup": "node scripts/setup-posthog.ts",
    "test:publish": "node --test scripts/b2-publishing.test.ts",
    "publish:b2": "node scripts/browser-guard.ts node scripts/publish-b2.ts",
    "test:mandate": "node --test scripts/mandate-input.test.ts",
    "test:chronicle-language": "node --test scripts/chronicle-language.test.ts",
    "test:companions": "node --test scripts/companions.test.ts",
    "test:premises": "node --test scripts/premises.test.ts",
    "test:office": "node --test scripts/office-tour.test.ts",
    "test:supervision": "node --test scripts/office-supervision.test.ts scripts/office-cadence.test.ts",
    "test:layout": "node --test scripts/office-layout.test.ts scripts/office-partition.test.ts scripts/office-relocation.test.ts scripts/office-estate-records.test.ts",
    "test:heist": "node --test scripts/office-heist.test.ts",
    "test:workspace": "node --test scripts/demo-workspace.test.ts",
    "test:aviation": "node --test scripts/office-flight.test.ts"
  },
  "dependencies": {
    "@babylonjs/core": "9.33.2",
    "posthog-js": "^1.442.1"
  }
}
