<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.seriouscompany.business.java.slopfizzbuzz</groupId>
    <artifactId>SlopFizzBuzzReactor</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <artifactId>SlopFizzBuzzEnterpriseEdition</artifactId>
  <dependencies>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>2.5.250</version>
    </dependency>
    <dependency>
      <groupId>javax.annotation</groupId>
      <artifactId>javax.annotation-api</artifactId>
      <version>1.3.2</version>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-aop</artifactId>
      <version>3.2.13.RELEASE</version>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-beans</artifactId>
      <version>3.2.13.RELEASE</version>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
      <version>3.2.13.RELEASE</version>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-core</artifactId>
      <version>3.2.13.RELEASE</version>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-expression</artifactId>
      <version>3.2.13.RELEASE</version>
    </dependency>
    <dependency>
      <groupId>com.seriouscompany.business.java.slopfizzbuzz</groupId>
      <artifactId>SlopFizzBuzzCore</artifactId>
      <version>1.0-SNAPSHOT</version>
    </dependency>
  </dependencies>
  <build>
    <sourceDirectory>../src/main/java</sourceDirectory>
    <testSourceDirectory>../src/test/java</testSourceDirectory>
    <resources>
      <resource>
        <directory>${project.basedir}/..</directory>
        <includes>
          <include>CHANGELOG.md</include>
          <include>**/impl/cache/RedisProtocol.java</include>
        </includes>
      </resource>
      <resource>
        <directory>${project.basedir}/../docs</directory>
        <includes>
          <include>EXECUTIVE_CONTINUITY_AND_SENTIMENT_REGISTER.md</include>
        </includes>
      </resource>
      <resource>
        <directory>../src/main/resources</directory>
      </resource>
      <resource>
        <directory>../resources/assets/configuration/spring/dependencyinjection/configuration</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/impl/Main.java</include>
            <include>**/impl/ApplicationContextHolder.java</include>
            <include>**/impl/audit/H2AuditStore.java</include>
            <include>**/impl/audit/JvmAuditDigest.java</include>
            <include>**/impl/audit/JvmAuditJournalFactory.java</include>
            <include>**/impl/cache/RedisOutputCache.java</include>
            <include>**/impl/http/HttpMain.java</include>
            <include>**/impl/http/SlopFizzBuzzHttpServer.java</include>
            <include>**/impl/http/TraceCustodyFilter.java</include>
            <include>**/impl/http/StaticSiteHandler.java</include>
            <include>**/impl/http/ImprovementLedgerRenderer.java</include>
          </includes>
          <testIncludes>
            <testInclude>**/*.java</testInclude>
          </testIncludes>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.seriouscompany.business.java.slopfizzbuzz.packagenamingpackage.impl.Main</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
