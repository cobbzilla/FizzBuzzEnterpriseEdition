<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.seriouscompany.business.java.slopfizzbuzz</groupId>
    <artifactId>SlopFizzBuzzReactor</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <artifactId>SlopFizzBuzzCore</artifactId>
  <dependencies>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
      <version>3.2.13.RELEASE</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>javax.annotation</groupId>
      <artifactId>javax.annotation-api</artifactId>
      <version>1.3.2</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <build>
    <sourceDirectory>../src/main/java</sourceDirectory>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/impl/Main.java</exclude>
            <exclude>**/impl/ApplicationContextHolder.java</exclude>
            <exclude>**/impl/audit/H2AuditStore.java</exclude>
            <exclude>**/impl/audit/JvmAuditDigest.java</exclude>
            <exclude>**/impl/audit/JvmAuditJournalFactory.java</exclude>
            <exclude>**/impl/cache/RedisOutputCache.java</exclude>
            <exclude>**/impl/http/HttpMain.java</exclude>
            <exclude>**/impl/http/SlopFizzBuzzHttpServer.java</exclude>
            <exclude>**/impl/http/TraceCustodyFilter.java</exclude>
            <exclude>**/impl/http/StaticSiteHandler.java</exclude>
            <exclude>**/impl/http/ImprovementLedgerRenderer.java</exclude>
            <exclude>**/impl/cache/RedisProtocol.java</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
